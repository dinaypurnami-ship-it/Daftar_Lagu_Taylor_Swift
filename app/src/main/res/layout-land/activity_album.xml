<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/spotify_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="22dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.9"
            android:orientation="vertical"
            android:paddingEnd="14dp">

            <TextView
                android:id="@+id/txtAlbumTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Album"
                android:textColor="@android:color/white"
                android:textSize="30sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Taylor Swift Playlist"
                android:textColor="@color/spotify_green"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="18dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_spotify_card"
                android:padding="14dp">

                <EditText
                    android:id="@+id/edtSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_spotify_search"
                    android:hint="Search song..."
                    android:textColor="@android:color/white"
                    android:textColorHint="@color/spotify_text_gray"
                    android:inputType="text"
                    android:minHeight="48dp"
                    android:padding="12dp"
                    android:layout_marginBottom="10dp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_spotify_green"
                    android:text="Search"
                    android:textAllCaps="false"
                    android:textColor="@android:color/black"
                    android:textStyle="bold"
                    android:padding="12dp"
                    android:layout_marginBottom="10dp"
                    app:backgroundTint="@null" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSortAz"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_spotify_green"
                    android:text="Sort A-Z"
                    android:textAllCaps="false"
                    android:textColor="@android:color/black"
                    android:textStyle="bold"
                    android:padding="12dp"
                    android:layout_marginBottom="10dp"
                    app:backgroundTint="@null" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSortZa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_spotify_green"
                    android:text="Sort Z-A"
                    android:textAllCaps="false"
                    android:textColor="@android:color/black"
                    android:textStyle="bold"
                    android:padding="12dp"
                    app:backgroundTint="@null" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:orientation="vertical"
            android:paddingStart="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Songs"
                android:textColor="@android:color/white"
                android:textSize="21sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/song1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_spotify_card_light"
                android:padding="14dp"
                android:text="Song 1"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/song2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_spotify_card_light"
                android:padding="14dp"
                android:text="Song 2"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/song3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_spotify_card_light"
                android:padding="14dp"
                android:text="Song 3"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/song4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_spotify_card_light"
                android:padding="14dp"
                android:text="Song 4"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/song5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_spotify_card_light"
                android:padding="14dp"
                android:text="Song 5"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>